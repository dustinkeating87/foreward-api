# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL — found at: Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Anon / public JWT key (starts with eyJ...)
SUPABASE_KEY=eyJ...
# Service role secret JWT key (starts with eyJ...) — never expose publicly
SUPABASE_SERVICE_KEY=eyJ...

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Secret key — sk_test_... for test mode, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from `stripe listen` or Stripe dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price ID for the $10/month plan
STRIPE_PRICE_ID=price_...

# ── Export API key ─────────────────────────────────────────────────────────────
# Shared secret used by the tee-sniper polling engine to call GET /export-alerts
# Set the same value in ~/tee-sniper/.env as ALERTS_API_KEY
EXPORT_API_KEY=your-secret-export-key

# ── URLs ───────────────────────────────────────────────────────────────────────
# Public base URL of this API (used for internal links)
BASE_URL=https://your-app.up.railway.app
# Where Stripe redirects after checkout
SUCCESS_URL=https://your-frontend.com/success
CANCEL_URL=https://your-frontend.com/cancel
